# Next.js Supabase Environment Configuration
# Public keys safe for browser/client components
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Privileged service role key: ONLY used server-side / one-time import / trusted environments
# NEVER expose with NEXT_PUBLIC_ prefix!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
