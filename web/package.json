{
  "name": "amazonml-challenge-explorer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare-data": "tsx scripts/prepare-data.ts",
    "sync": "tsx scripts/sync-all.ts",
    "sync:watch": "tsx scripts/sync-all.ts --watch --interval 60",
    "sync:fast:watch": "tsx scripts/sync-all.ts --regenerate-only --watch --interval 30",
    "fetch-data": "tsx scripts/sync-all.ts --force",
    "fetch-data:watch": "tsx scripts/sync-all.ts --force --watch",
    "dev": "npm run prepare-data && next dev",
    "build": "npm run prepare-data && next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
