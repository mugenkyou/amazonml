# Next.js Supabase Environment Configuration
# Public keys safe for browser/client components
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Privileged service role key: ONLY used server-side / collector / trusted environments
